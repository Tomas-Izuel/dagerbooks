{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "titleEs": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "year": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 2100
    },
    "kind": {
      "type": "string",
      "enum": [
        "book",
        "essay",
        "paper",
        "course",
        "textbook"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fundamentos",
          "matematicas",
          "sistemas",
          "economia",
          "filosofia",
          "historia",
          "desarrollo-personal",
          "startups",
          "oficio",
          "arquitectura",
          "ia",
          "ficcion"
        ]
      }
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "high"
            ]
          },
          "stance": {
            "type": "string",
            "enum": [
              "recommends",
              "mixed",
              "mentions",
              "criticizes"
            ]
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "leadsTo": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "gap": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": [
                      "fuerte",
                      "muy-fuerte"
                    ]
                  },
                  "bridge": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "severity",
                  "bridge"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "gap"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "isbn": {
      "type": "string",
      "pattern": "^\\d{9}[\\dXx]$|^\\d{13}$"
    },
    "coverId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "asin": {
      "type": "string",
      "pattern": "^[A-Z0-9]{10}$"
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "fuerte",
        "interesante",
        "mencion"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "topics",
    "level"
  ],
  "additionalProperties": false
}
