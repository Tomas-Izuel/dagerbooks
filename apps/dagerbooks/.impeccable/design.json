  "components": [
    {
      "name": "Solid Sign Button",
      "kind": "button",
      "refersTo": "button-solid",
      "description": "Primary ruled sign with arrow; ink fill that empties to an outline on hover.",
      "html": "<a class=\"ds-btn ds-btn-solid\" href=\"#\">Ver en el mapa <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M2 8h11M9 4l4 4-4 4\"/></svg></a>",
      "css": ".ds-btn{--ink:var(--porcelain-50,#f3f1ea);display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 16px;border:2px solid var(--ink);border-radius:2px;font-family:var(--font-sign,Overpass,system-ui,sans-serif);font-size:.875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:background-color 140ms cubic-bezier(.16,1,.3,1),color 140ms cubic-bezier(.16,1,.3,1)} .ds-btn svg{transition:transform 140ms cubic-bezier(.16,1,.3,1)} .ds-btn:hover svg{transform:translateX(2px)} .ds-btn:focus-visible{outline:2px solid #ffc20e;outline-offset:3px} .ds-btn-solid{background:var(--ink);color:#070c22} .ds-btn-solid:hover{background:transparent;color:var(--ink)}"
    },
    {
      "name": "Ghost Sign Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary ruled sign; transparent, fills with its ink on hover.",
      "html": "<a class=\"ds-btn ds-btn-ghost\" href=\"#\">Rutas <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M2 8h11M9 4l4 4-4 4\"/></svg></a>",
      "css": ".ds-btn{--ink:var(--porcelain-50,#f3f1ea);display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 16px;border:2px solid var(--ink);border-radius:2px;font-family:var(--font-sign,Overpass,system-ui,sans-serif);font-size:.875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:background-color 140ms cubic-bezier(.16,1,.3,1),color 140ms cubic-bezier(.16,1,.3,1)} .ds-btn svg{transition:transform 140ms cubic-bezier(.16,1,.3,1)} .ds-btn:hover svg{transform:translateX(2px)} .ds-btn:focus-visible{outline:2px solid #ffc20e;outline-offset:3px} .ds-btn-ghost{background:transparent;color:#f3f1ea} .ds-btn-ghost:hover{background:var(--ink);color:#070c22}"
    },
    {
      "name": "Follow Route Button",
      "kind": "button",
      "refersTo": "button-solid",
      "description": "\"Seguir esta ruta\": the solid sign at 48px in the route's ink.",
      "html": "<button class=\"ds-follow\" style=\"--ink:#b07cf0\">Seguir esta ruta</button>",
      "css": ".ds-follow{min-height:48px;padding:8px 24px;border:2px solid var(--ink);border-radius:2px;background:var(--ink);color:#070c22;font-family:Overpass,system-ui,sans-serif;font-size:.875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background-color 140ms cubic-bezier(.16,1,.3,1),color 140ms cubic-bezier(.16,1,.3,1)} .ds-follow:hover{background:transparent;color:var(--ink)} .ds-follow:focus-visible{outline:2px solid #ffc20e;outline-offset:2px}"
    },
    {
      "name": "Lo leí Ticket",
      "kind": "custom",
      "refersTo": "ticket-punch",
      "description": "The fare ticket the reader punches; ámbar unpunched, ruled porcelain once punched.",
      "html": "<button class=\"ds-punch\" aria-pressed=\"false\"><svg width=\"28\" height=\"20\" viewBox=\"0 0 28 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M2 3h24v4a3 3 0 0 0 0 6v4H2v-4a3 3 0 0 0 0-6z\"/><circle cx=\"14\" cy=\"10\" r=\"2.5\" fill=\"currentColor\"/></svg><span class=\"ds-punch-text\"><span class=\"ds-punch-label\">Lo leí</span><span class=\"ds-punch-state\">Sin picar</span></span></button> <button class=\"ds-punch\" aria-pressed=\"true\"><svg width=\"28\" height=\"20\" viewBox=\"0 0 28 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M2 3h24v4a3 3 0 0 0 0 6v4H2v-4a3 3 0 0 0 0-6z\"/><circle cx=\"14\" cy=\"10\" r=\"2.5\" fill=\"currentColor\"/></svg><span class=\"ds-punch-text\"><span class=\"ds-punch-label\">Lo leí</span><span class=\"ds-punch-state\">Picado</span></span></button>",
      "css": ".ds-punch{display:inline-flex;align-items:center;gap:12px;min-height:48px;padding:8px 16px;border:2px solid #ffc20e;border-radius:2px;background:#ffc20e;color:#070c22;text-align:start;cursor:pointer;transition:background-color 140ms cubic-bezier(.16,1,.3,1),color 140ms cubic-bezier(.16,1,.3,1)} .ds-punch:hover{background:#f3f1ea;border-color:#f3f1ea} .ds-punch:focus-visible{outline:2px solid #ffc20e;outline-offset:2px} .ds-punch[aria-pressed=true]{background:transparent;border-color:#f3f1ea;color:#f3f1ea} .ds-punch[aria-pressed=true]:hover{background:#142045} .ds-punch-text{display:grid} .ds-punch-label{font-family:'Big Shoulders','Arial Narrow',sans-serif;font-size:1.1875rem;font-weight:800;letter-spacing:.12em;line-height:1.1;text-transform:uppercase} .ds-punch-state{font-family:Overpass,system-ui,sans-serif;font-size:.75rem;opacity:.85}"
    },
