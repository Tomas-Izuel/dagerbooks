# Set it to the production domain (no trailing slash), e.g. https://dagerbooks.com
# If empty, the app falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL (previews),
# then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
