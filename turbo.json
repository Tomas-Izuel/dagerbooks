{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SITE_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "validate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research/**",
        "!**/*.md"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "GITHUB_APP_ID",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_INSTALLATION_ID",
        "SUGGESTIONS_REPO",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ]
    },
    "validate": {
      "inputs": [
        "content/**",
        "lib/**",
        "scripts/**",
        "package.json"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {},
    "check:subway": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
