{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "titleEs": {
        "type": "string",
        "minLength": 1
      },
      "authors": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "year": {
        "type": "integer",
        "minimum": -1000,
        "maximum": 2100
      },
      "kind": {
        "type": "string",
        "enum": [
          "book",
          "essay",
          "paper",
          "course",
          "textbook"
        ]
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "fundamentos",
            "matematicas",
            "sistemas",
            "economia",
            "filosofia",
            "historia",
            "desarrollo-personal",
            "startups",
            "oficio",
            "arquitectura",
            "ia",
            "ficcion"
          ]
        }
      },
      "level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "timestamp": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "string",
              "enum": [
                "low",
                "high"
              ]
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      },
      "leadsTo": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "related": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "isbn": {
        "type": "string",
        "pattern": "^\\d{9}[\\dXx]$|^\\d{13}$"
      },
      "coverId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "recommendation": {
        "type": "string",
        "enum": [
          "fuerte",
          "interesante",
          "mencion"
        ]
      },
      "confidence": {
        "type": "string",
        "enum": [
          "low",
          "high"
        ]
      }
    },
    "required": [
      "id",
      "title",
      "topics",
      "level"
    ],
    "additionalProperties": false
  }
}
